# Staging overrides - Copy to .env.staging
# Loaded when APP_ENV=staging (overrides .env)
APP_ENV=staging

DEBUG=false
LOG_LEVEL=INFO
API_PORT=8000

# Databases (Docker Compose service names)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=opsly

ENABLE_MILVUS=false
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=opsly

# Agent URLs (Docker Compose service names)
ORCHESTRATOR_AGENT_URL=http://orchestrator-agent:8001
INDEXER_AGENT_URL=http://indexer-agent:8002
GRAPH_QUERY_AGENT_URL=http://graph-query-agent:8003
CODE_ANALYST_AGENT_URL=http://code-analyst-agent:8004
RETRIEVAL_MEMORY_AGENT_URL=http://retrieval-memory-agent:8005

# Repository
FASTAPI_REPO_URL=https://github.com/tiangolo/fastapi.git
REPO_WORKSPACE=/tmp/opsly/repos

# LLM Routing
LLM_DEFAULT_PROVIDER=openai
LLM_FALLBACK_ORDER=openai,anthropic,gemini

# Embedding
EMBEDDING_DEFAULT_PROVIDER=openai
EMBEDDING_MODEL_CODE=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Agent behavior
AGENT_TIMEOUT_SECONDS=30.0
AGENT_MAX_RETRIES=2

# API Authentication
AUTH_USER_ID=tanzir
AUTH_PASSWORD=khan
AUTH_JWT_SECRET=opsly-dev-secret-change-me
AUTH_JWT_EXP_MINUTES=60

# LLM API Keys
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=
