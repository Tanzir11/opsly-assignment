# ─────────────────────────────────────────────────────────────
# APP_ENV flag: development | staging | production
# Determines which .env.{flag} file is loaded for overrides.
# ─────────────────────────────────────────────────────────────
APP_ENV=development

# Application
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8000

# ─── Databases ──────────────────────────────────────────────
# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=opsly_dev_password

# MongoDB (conversation memory, agent cache, job tracking)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=opsly

# Milvus (vector embeddings)
ENABLE_MILVUS=false
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=opsly

# ─── MCP Agent URLs ────────────────────────────────────────
ORCHESTRATOR_AGENT_URL=http://localhost:8001
INDEXER_AGENT_URL=http://localhost:8002
GRAPH_QUERY_AGENT_URL=http://localhost:8003
CODE_ANALYST_AGENT_URL=http://localhost:8004
RETRIEVAL_MEMORY_AGENT_URL=http://localhost:8005

# ─── Repository Settings ───────────────────────────────────
FASTAPI_REPO_URL=https://github.com/tiangolo/fastapi.git
REPO_WORKSPACE=/tmp/opsly/repos

# ─── LLM Routing ───────────────────────────────────────────
LLM_DEFAULT_PROVIDER=openai
LLM_FALLBACK_ORDER=openai,anthropic,gemini

# ─── Embedding Settings ────────────────────────────────────
EMBEDDING_DEFAULT_PROVIDER=openai
EMBEDDING_MODEL_CODE=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─── Agent Timeouts ────────────────────────────────────────
AGENT_TIMEOUT_SECONDS=30.0
AGENT_MAX_RETRIES=2

# ─── LLM API Keys ──────────────────────────────────────────
# Multiple keys per provider for load balancing / rotation
# OpenAI
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
# OPENAI_API_KEY_3=
# OPENAI_API_KEY_4=
# OPENAI_API_KEY_5=

# Gemini (Google)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Anthropic
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=
# ANTHROPIC_API_KEY_3=
