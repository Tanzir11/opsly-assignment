# Development overrides - Copy to .env.develop
# Loaded when APP_ENV=development (overrides .env)
APP_ENV=development

DEBUG=true
LOG_LEVEL=DEBUG
API_PORT=8000

# Databases (local Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=opsly_dev_password

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=opsly

ENABLE_MILVUS=false
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Agent URLs (local)
ORCHESTRATOR_AGENT_URL=http://localhost:8001
INDEXER_AGENT_URL=http://localhost:8002
GRAPH_QUERY_AGENT_URL=http://localhost:8003
CODE_ANALYST_AGENT_URL=http://localhost:8004
RETRIEVAL_MEMORY_AGENT_URL=http://localhost:8005

# Repository
FASTAPI_REPO_URL=https://github.com/tiangolo/fastapi.git
REPO_WORKSPACE=/tmp/opsly/repos

# Embeddings (lighter local setup via hosted API)
EMBEDDING_DEFAULT_PROVIDER=openai
EMBEDDING_MODEL_CODE=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLM API Keys
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=
